<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="flex flex-col items-center justify-center min-h-[40vh]">
    <div class="w-full max-w-2xl p-8 rounded-2xl shadow-xl bg-base-100/90 mt-16 mb-8">
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-primary">Welcome to StockFeed!</h1>
      </div>
      <p class="text-lg text-base-content/80 mb-6">
        Track real-time stock prices, manage your favorite assets, and enjoy a modern, responsive experience built with Phoenix LiveView.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <.link navigate={~p"/users/register"} class="btn btn-primary flex-1 text-lg">Register</.link>
        <.link navigate={~p"/users/log-in"} class="btn btn-outline flex-1 text-lg">Login</.link>
      </div>
    </div>
  </div>
</Layouts.app>